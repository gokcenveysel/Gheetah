@model Gheetah.Models.ViewModels.Dashboard.PushHistoryWidgetVm
@{
    var pageSize = 10;
    var page = 1;
    var totalItems = Model.Histories.Count;
    var totalPages = (int)Math.Ceiling((double)totalItems / pageSize);
    var pagedHistories = Model.Histories.Skip((page - 1) * pageSize).Take(pageSize).ToList();
}

<div class="table-responsive">
    <table class="table table-vcenter table-hover card-table">
        <thead>
            <tr>
                <th class="w-25">Project</th>
                <th class="w-20">Branch</th>
                <th class="w-20">Commit</th>
                <th class="w-25">Date</th>
                <th class="w-10">PR Created</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in pagedHistories)
            {
                <tr>
                    <td>
                        <div class="d-flex align-items-center">
                            <div class="me-2">
                                <svg xmlns="http://www.w3.org/2000/svg" class="icon text-muted" width="20" height="20" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                                    <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                    <path d="M7 12m-3 0a3 3 0 1 0 6 0a3 3 0 1 0 -6 0" />
                                    <path d="M17 6m-3 0a3 3 0 1 0 6 0a3 3 0 1 0 -6 0" />
                                    <path d="M17 18m-3 0a3 3 0 1 0 6 0a3 3 0 1 0 -6 0" />
                                    <path d="M9 13l4 3" />
                                    <path d="M13 8l-4 3" />
                                </svg>
                            </div>
                            <div>
                                <div class="fw-bold">@item.ProjectName</div>
                                <div class="text-muted small">by @item.PushedBy</div>
                            </div>
                        </div>
                    </td>
                    <td>
                        <span class="badge bg-azure-lt">
                            <svg xmlns="http://www.w3.org/2000/svg" class="icon me-1" width="14" height="14" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                                <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                <path d="M9 6l6 6l-6 6" />
                            </svg>
                            @item.BranchName
                        </span>
                    </td>
                    <td>
                        <code class="text-primary bg-light p-1 rounded">@item.CommitHash</code>
                    </td>
                    <td>
                        <div class="text-muted small">@item.PushedAt</div>
                    </td>
                    <td>
                        @if (item.HasPR)
                        {
                            <span class="badge bg-green-lt">
                                <svg xmlns="http://www.w3.org/2000/svg" class="icon me-1" width="14" height="14" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                                    <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                    <path d="M5 12l5 5l10 -10" />
                                </svg>
                                Yes
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary-lt">
                                <svg xmlns="http://www.w3.org/2000/svg" class="icon me-1" width="14" height="14" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                                    <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                    <path d="M18 6l-12 12" />
                                    <path d="M6 6l12 12" />
                                </svg>
                                No
                            </span>
                        }
                    </td>
                </tr>
            }
            @if (!pagedHistories.Any())
            {
                <tr>
                    <td colspan="5" class="text-center text-muted py-4">
                        <div class="empty">
                            <div class="empty-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                                    <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                                    <path d="M7 12m-3 0a3 3 0 1 0 6 0a3 3 0 1 0 -6 0" />
                                    <path d="M17 6m-3 0a3 3 0 1 0 6 0a3 3 0 1 0 -6 0" />
                                    <path d="M17 18m-3 0a3 3 0 1 0 6 0a3 3 0 1 0 -6 0" />
                                    <path d="M9 13l4 3" />
                                    <path d="M13 8l-4 3" />
                                </svg>
                            </div>
                            <p class="empty-title">No push history</p>
                            <p class="empty-subtitle text-muted">You haven't pushed any commits yet.</p>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (totalPages > 1)
{
    <div class="card-footer d-flex align-items-center justify-content-between">
        <div class="text-muted small">
            Showing <span class="fw-bold">@((page - 1) * pageSize + 1)</span> to <span class="fw-bold">@Math.Min(page * pageSize, totalItems)</span> of <span class="fw-bold">@totalItems</span> pushes
        </div>
        <ul class="pagination m-0 ms-auto" data-page-size="@pageSize" data-total-items="@totalItems" data-widget-type="pushhistory">
            <li class="page-item @(page == 1 ? "disabled" : "")" data-page="@(page - 1)"><a class="page-link" href="#">Prev</a></li>
            @for (int i = 1; i <= totalPages && i <= 5; i++)
            {
                <li class="page-item @(i == page ? "active" : "")" data-page="@i"><a class="page-link" href="#">@i</a></li>
            }
            @if (totalPages > 5)
            {
                <li class="page-item disabled"><span class="page-link">...</span></li>
                <li class="page-item" data-page="@totalPages"><a class="page-link" href="#">@totalPages</a></li>
            }
            <li class="page-item @(page == totalPages ? "disabled" : "")" data-page="@(page + 1)"><a class="page-link" href="#">Next</a></li>
        </ul>
    </div>
}