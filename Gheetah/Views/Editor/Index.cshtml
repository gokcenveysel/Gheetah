@{
    ViewData["Title"] = "Gheetah IDE - " + ViewBag.ProjectName;
}

<style>
    /* Step Definition Linker Highlight */
    .step-definition-highlight {
        background-color: rgba(0, 84, 166, 0.15) !important;
    }

    .step-definition-glyph {
        background: #0054a6;
        width: 3px !important;
        margin-left: 3px;
    }
    /* 1. LAYOUT & SCROLL MANAGEMENT */
    html, body {
        height: 100%;
        margin: 0;
        padding: 0;
        overflow: hidden; /* Tarayıcı scroll'unu tamamen engelle */
    }

    .page-wrapper {
        height: calc(100vh - 64px);
        display: flex;
        flex-direction: column;
        width: 100%;
        overflow: hidden;
        background: #ffffff;
        position: relative; /* İçerideki fixed eleman için referans */
        padding-bottom: 28px; /* Status bar yüksekliği + biraz boşluk */
    }

    .ide-workspace {
        display: flex;
        flex-direction: row;
        flex: 1;
        overflow: hidden;
    }

    /* Tabler.io Modern Status Bar */
    .status-bar {
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        height: 26px;
        background: #f6f8fb; /* Tabler light background */
        color: #656d77; /* Tabler muted text */
        border-top: 1px solid rgba(101, 109, 119, 0.16);
        display: flex;
        align-items: center;
        padding: 0 12px;
        font-size: 11px;
        font-weight: 500;
        gap: 16px;
        z-index: 1050; /* Monaco Editör'ün üzerinde kalması için */
        user-select: none;
    }

    /* Status Bar Item Tasarımı */
    .status-item {
        display: flex;
        align-items: center;
        gap: 6px;
        color: #495057;
    }

        .status-item i {
            font-size: 13px;
            color: #656d77;
        }

        .status-item:hover {
            color: #0054a6; /* Tabler Primary */
        }

    .status-divider {
        width: 1px;
        height: 12px;
        background: rgba(101, 109, 119, 0.2);
    }

    /* 2. SIDEBAR (EXPLORER & GIT) STYLING */
    .sidebar-container {
        width: 300px;
        min-width: 300px;
        max-width: 400px;
        height: 100%;
        display: flex;
        flex-direction: column;
        background: #f8f9fa;
        border-right: 1px solid #dee2e6;
        flex-shrink: 0;
    }

    .explorer-tabs {
        height: 38px;
        background: #f1f3f5;
        display: flex;
        border-bottom: 1px solid #dee2e6;
        flex-shrink: 0;
    }

    .explorer-tab-item {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        font-size: 11px;
        font-weight: 700;
        color: #6c757d;
        border-right: 1px solid #dee2e6;
        text-transform: uppercase;
        transition: all 0.2s ease;
    }

        .explorer-tab-item.active {
            background: #ffffff;
            color: #0054a6;
            border-bottom: 2px solid #0054a6;
        }

    /* Panellerin İçeriği */
    .panel-content {
        flex-grow: 1;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
    }

    /* 3. PUSH HISTORY PANEL (Sidebar Alt Kısmı) */
    .push-history-panel {
        height: 220px;
        border-top: 1px solid #dee2e6;
        background: #ffffff;
        display: flex;
        flex-direction: column;
        flex-shrink: 0;
    }

    #push-history-list {
        flex-grow: 1;
        overflow-y: auto;
        padding: 8px;
    }

    /* 4. MAIN EDITOR AREA STYLING */
    .editor-main-area {
        flex-grow: 1;
        display: flex;
        flex-direction: column;
        height: 100%;
        overflow: hidden;
        background: #ffffff;
    }

    /* Editor Tabs (Monaco Üstü) */
    #editor-tabs {
        height: 38px;
        background: #f1f3f5;
        display: flex;
        align-items: center;
        padding: 0 10px;
        gap: 4px;
        border-bottom: 1px solid #dee2e6;
        overflow-x: auto;
        flex-shrink: 0;
    }

    .tab-item {
        padding: 6px 12px;
        background: #e9ecef;
        border: 1px solid #ced4da;
        border-bottom: none;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        font-size: 12px;
        border-radius: 4px 4px 0 0;
        margin-top: 6px;
        white-space: nowrap;
    }

        .tab-item.active {
            background: #ffffff;
            border-bottom: 2px solid #0054a6;
            font-weight: bold;
        }

    .tab-close {
        margin-left: 8px;
        font-size: 14px;
        color: #adb5bd;
    }

        .tab-close:hover {
            color: #e74c3c;
        }

    /* Monaco Container */
    #monaco-container {
        flex-grow: 1;
        width: 100%;
        height: 100%;
    }

    /* 5. JSTREE & ICON CUSTOMIZATION */
    .jstree-default .jstree-anchor {
        font-size: 13px !important;
    }

    .jstree-default .jstree-themeicon {
        font-size: 1.2rem !important;
    }

    .ti-folder, .ti-folder-open {
        color: #0054a6 !important;
    }

    .ti-brand-c-sharp {
        color: #6a1b9a !important;
    }

    .ti-brand-cucumber {
        color: #2e7d32 !important;
    }

    /* Dirty (Kaydedilmemiş) Dosya Belirteci */
    .file-dirty > a.jstree-anchor {
        color: #e74c3c !important;
        font-weight: 600;
    }

        .file-dirty > a.jstree-anchor:after {
            content: ' ●';
            font-size: 9px;
            vertical-align: middle;
        }

    /* Ghost Buttons */
    .btn-ghost-secondary {
        border: none;
        background: transparent;
        color: #616876;
        padding: 4px 8px;
        border-radius: 4px;
    }

        .btn-ghost-secondary:hover {
            background: #f1f3f5;
            color: #0054a6;
        }

    .btn-toolbar-active {
        color: #0054a6 !important;
    }
</style>

<div class="page-wrapper">
    <div class="ide-workspace">
        <!-- LEFT SIDEBAR -->
        <aside class="sidebar-container">
            <div class="explorer-tabs">
                <div id="tab-solution" class="explorer-tab-item active" onclick="switchSidebar('solution')">
                    <i class="ti ti-files me-1"></i> Solution
                </div>
                <div id="tab-git" class="explorer-tab-item" onclick="switchSidebar('git')">
                    <i class="ti ti-git-pull-request me-1"></i> Git
                </div>
            </div>

            <div id="panel-solution" class="panel-content">
                <div class="p-2 border-bottom bg-white d-flex justify-content-between align-items-center">
                    <strong class="small text-muted">FILES</strong>
                    <div class="d-flex gap-1">
                        <button id="btn-save" class="btn-ghost-secondary" onclick="saveCurrentFile()" disabled title="Save (Ctrl+S)">
                            <i class="ti ti-device-floppy fs-3"></i>
                        </button>
                        <button id="btn-save-all" class="btn-ghost-secondary" onclick="saveAllFiles()" disabled title="Save All">
                            <i class="ti ti-files fs-3"></i>
                        </button>
                        <div class="vr mx-1"></div>
                        <button class="btn-ghost-secondary" onclick="refreshTree()" title="Refresh">
                            <i class="ti ti-refresh fs-3"></i>
                        </button>
                    </div>
                </div>
                <div id="editor-treeview" class="p-1"></div>
            </div>

            <div id="panel-git" class="panel-content d-none">
                <div class="p-2 bg-light border-bottom">
                    <select id="branch-dropdown" class="form-select form-select-sm mb-2" onchange="handleBranchChange(this.value)"></select>
                    <div class="d-flex gap-1">
                        <button class="btn btn-sm btn-primary w-50" onclick="window.pullLatest()"><i class="ti ti-download me-1"></i> Pull</button>
                        <button id="btn-git-push" class="btn btn-sm btn-success w-50" onclick="handlePushAction()"><i class="ti ti-upload me-1"></i> Push</button>
                    </div>
                </div>
                <div class="p-2 small fw-bold text-muted border-bottom bg-white">CHANGES</div>
                <div id="git-changes-treeview" class="p-1"></div>
            </div>

            <div class="push-history-panel">
                <div class="p-2 bg-light border-bottom d-flex justify-content-between align-items-center">
                    <strong class="small text-muted">PUSH HISTORY</strong>
                    <button class="btn-ghost-secondary" onclick="openHistoryModal()">
                        <i class="ti ti-maximize fs-3"></i>
                    </button>
                </div>
                <div id="push-history-list"></div>
            </div>
        </aside>

        <!-- MAIN CONTENT -->
        <main class="editor-main-area">
            <div id="editor-tabs">
                <span id="no-file-msg" class="text-muted small italic px-2">No file open</span>
            </div>
            <div id="monaco-container"></div>
        </main>
        <!-- STATUS BAR -->
        <footer class="status-bar">
            <div class="status-item">
                <i class="ti ti-file-plus"></i>
                <span><b>Ctrl+Shift+N:</b> New File</span>
            </div>
            <div class="status-divider"></div>
            <div class="status-item">
                <i class="ti ti-device-floppy"></i>
                <span><b>Ctrl+S:</b> Save</span>
            </div>
            <div class="status-divider"></div>
            <div class="status-item">
                <i class="ti ti-square-x"></i>
                <span><b>Ctrl+Q:</b> Close Tab</span>
            </div>
            <div class="status-divider"></div>
            <div class="status-item">
                <i class="ti ti-arrows-left-right"></i>
                <span><b>Ctrl+1-9:</b> Switch Tab</span>
            </div>
            <div class="status-divider"></div>
            <div class="status-item">
                <i class="ti ti-trash"></i>
                <span><b>Del:</b> Delete File</span>
            </div>
            <div class="status-divider"></div>
            <div class="status-item">
                <i class="ti ti-link"></i>
                <span><b>Ctrl+Click:</b> Go to Definition</span>
            </div>
            <div class="ms-auto d-flex align-items-center gap-2">
                <div class="status-item text-primary">
                    <i class="ti ti-git-branch"></i>
                    <span id="status-branch" class="fw-bold">@ViewBag.CurrentBranch</span>
                </div>
            </div>
        </footer>
    </div>
</div>

<!-- MODALS -->
<div class="modal modal-blur fade" id="modal-history-large" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Push & Deployment History</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body overflow-auto" style="max-height: 75vh;">
                <table class="table table-vcenter">
                    <thead>
                        <tr>
                            <th>Branch</th>
                            <th>Base</th>
                            <th>Pushed By</th>
                            <th>Date</th>
                            <th>Commit</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody id="full-history-table-body"></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal modal-blur fade" id="modal-branch" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Commit to New Branch</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <label class="form-label">Branch Name</label>
                <input type="text" id="input-branch-name" class="form-control" placeholder="feature/new-test">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-link link-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-success" onclick="commitAndPush()">Commit & Push</button>
            </div>
        </div>
    </div>
</div>
<!-- ADD NEW ITEM MODAL -->
<div class="modal modal-blur fade" id="modal-new-file" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Add New Item</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">File Type</label>
                    <select id="new-file-type" class="form-select" onchange="updateTemplateOptions()">
                        <option value="cs">C# Class (.cs)</option>
                        <option value="feature">Feature File (.feature)</option>
                        <option value="java">Java Class (.java)</option>
                        <option value="xml">XML File (.xml)</option>
                        <option value="json">JSON File (.json)</option>
                    </select>
                </div>
                <div class="mb-3" id="template-selector" style="display: none;">
                    <label class="form-label">Template</label>
                    <select id="new-file-template" class="form-select">
                        <option value="class">Class</option>
                        <option value="interface">Interface</option>
                        <option value="stepdef">Step Definition</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">File Name (without extension)</label>
                    <input type="text" id="new-file-name" class="form-control" placeholder="e.g., LoginSteps">
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-link link-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="createNewFile()">Create</button>
            </div>
        </div>
    </div>
</div>
<!-- CREATE PR DETAIL MODAL -->
<div class="modal modal-blur fade" id="modal-create-pr-detail" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Create Pull Request</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-lg-6">
                        <div class="mb-3">
                            <label class="form-label">Source Branch</label>
                            <input type="text" id="pr-source-branch" class="form-control" readonly>
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="mb-3">
                            <label class="form-label">Target Branch</label>
                            <select id="pr-target-branch" class="form-select" onchange="validatePRForm()">
                                <option value="">Select Target...</option>
                                <option value="main">main</option>
                                <option value="develop">develop</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Reviewers (Admin/Lead)</label>
                    <select id="pr-reviewers" class="form-select" multiple>
                        <option value="admin_1">Senior Architect (Admin)</option>
                        <option value="lead_1">Team Lead (Lead)</option>
                    </select>
                    <small class="text-muted">Hold Ctrl to select multiple.</small>
                </div>
                <div class="mb-3">
                    <label class="form-label">Description / Comments</label>
                    <textarea id="pr-comment" class="form-control" rows="3" placeholder="What changed in this PR?" oninput="validatePRForm()"></textarea>
                </div>

                <div class="p-2 bg-light border rounded">
                    <strong class="small d-block mb-2 text-uppercase">Changed Files</strong>
                    <div id="pr-file-diff-list" class="small overflow-auto" style="max-height: 150px;">
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-link link-secondary me-auto" data-bs-dismiss="modal">Cancel</button>
                <button type="button" id="btn-submit-pr" class="btn btn-primary" onclick="finalizePRCreation()" disabled>
                    <i class="ti ti-git-pull-request me-1"></i> Create Pull Request
                </button>
            </div>
        </div>
    </div>
</div>
<div class="modal modal-blur fade" id="modal-confirm" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-sm modal-dialog-centered" role="document">
        <div class="modal-content">
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            <div class="modal-status bg-warning"></div>
            <div class="modal-body text-center py-4">
                <i class="ti ti-alert-triangle fs-1 text-warning mb-2"></i>
                <h3 id="confirm-title">Are you sure?</h3>
                <div id="confirm-text" class="text-muted"></div>
            </div>
            <div class="modal-footer">
                <div class="w-100">
                    <div class="row">
                        <div class="col"><a href="#" class="btn w-100" data-bs-dismiss="modal">Decline</a></div>
                        <div class="col"><a href="#" id="confirm-yes-btn" class="btn btn-warning w-100" data-bs-dismiss="modal">YES</a></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal modal-blur fade" id="modal-alert" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-sm modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-body text-center py-4">
                <i id="alert-icon" class="ti ti-info-circle fs-1 text-info mb-2"></i>
                <h3 id="alert-title">Bilgi</h3>
                <div id="alert-text" class="text-muted"></div>
            </div>
            <div class="modal-footer">
                <div class="w-100">
                    <a href="#" class="btn btn-primary w-100" data-bs-dismiss="modal">OK</a>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/jstree/3.3.12/themes/default/style.min.css" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jstree/3.3.12/jstree.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.34.1/min/vs/loader.min.js"></script>

    <script>
        var editor = null;
        var diffEditor = null;
        var isDiffMode = false;
        var projectId = "@ViewBag.ProjectId";
        var openFiles = {}; // { path: { model: obj, hash: str, fileName: str, isDirty: bool } }
        var activeFilePath = "";
        var hasServerChanges = false;
        var currentPRContext = {};
        var selectedFolderPath = null;

        require.config({ paths: { 'vs': 'https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.34.1/min/vs' } });

        $(document).ready(function () {
            initializeTree();
            refreshBranchList();
            refreshPushHistory();

            require(['vs/editor/editor.main'], function () {
                if (!monaco.languages.getLanguages().some(lang => lang.id === 'gherkin')) {
                    monaco.languages.register({ id: 'gherkin' });
                    monaco.languages.setMonarchTokensProvider('gherkin', {
                        keywords: ['Feature', 'Scenario', 'Scenario Outline', 'Given', 'When', 'Then', 'And', 'But', 'Background', 'Examples'],
                        tokenizer: {
                            root: [
                                [/[a-zA-Z][\w$]*/, {
                                    cases: {
                                    ['\x40' + 'keywords']: 'keyword',
                                    ['\x40' + 'default']: 'identifier'
                                    }
                                }],
                                [/\x40\w+/, 'type.identifier'],
                                [/"[^"]*"/, 'string'],
                                [/\b\d+\b/, 'number'],
                                [/^\s*#.*/, 'comment'],
                            ]
                        }
                    });
                }

                createNormalEditor();
                setupStepDefinitionLinker();

                // ==================== MONACO EDITOR ACTIONS (KESİN ÇALIŞIR) ====================
                editor.addAction({
                    id: 'save-file',
                    label: 'Save File',
                    keybindings: [monaco.KeyMod.CtrlCmd | monaco.KeyCode.KeyS],
                    run: function() {
                        if (activeFilePath && openFiles[activeFilePath] && openFiles[activeFilePath].isDirty) {
                            saveCurrentFile();
                        }
                    }
                });

                editor.addAction({
                    id: 'close-tab',
                    label: 'Close Tab',
                    keybindings: [monaco.KeyMod.CtrlCmd | monaco.KeyCode.KeyQ],
                    run: function() {
                        if (activeFilePath && openFiles[activeFilePath]) {
                            var path = activeFilePath;
                            var safeId = btoa(path).replace(/=/g, "");
                            if (openFiles[path].isDirty) {
                                showConfirm("Unsaved Changes", "Close anyway?", function() {
                                    executeTabClosure(path, safeId);
                                });
                            } else {
                                executeTabClosure(path, safeId);
                            }
                        }
                    }
                });

                // Ctrl+1'den Ctrl+9'a kadar tab'lara direkt geçiş
                for (var i = 1; i <= 9; i++) {
                    (function(index) {
                        editor.addAction({
                            id: 'switch-to-tab-' + index,
                            label: 'Switch to Tab ' + index,
                            keybindings: [monaco.KeyMod.CtrlCmd | (monaco.KeyCode.KEY_0 + index)],
                            run: function() {
                                var tabs = Object.keys(openFiles);
                                if (tabs.length >= index) {
                                    switchToTab(tabs[index - 1]);
                                }
                            }
                        });
                    })(i);
                }

                editor.addAction({
                    id: 'new-file',
                    label: 'New File',
                    keybindings: [monaco.KeyMod.CtrlCmd | monaco.KeyMod.Shift | monaco.KeyCode.KeyN],
                    run: function() {
                        var selectedNode = $('#editor-treeview').jstree(true).get_selected(true)[0];
                        if (selectedNode) {
                            var folderPath = selectedNode.original.type === 'folder' ? selectedNode.id : selectedNode.parent;
                            openNewFileDialog(folderPath);
                        } else {
                            showCustomToast('warning', 'Please select a folder first.');
                        }
                    }
                });
            });

            // Delete tuşu - sadece treeview'da çalışır
            document.addEventListener('keydown', function(e) {
                if (e.key === 'Delete') {
                    var activeEl = document.activeElement;
                    if (activeEl && activeEl.closest('.monaco-editor')) return;
                    if (activeEl && (activeEl.tagName === 'INPUT' || activeEl.tagName === 'TEXTAREA')) return;

                    var selectedNode = $('#editor-treeview').jstree(true).get_selected(true)[0];
                    if (selectedNode && selectedNode.original && selectedNode.original.type === 'file') {
                        e.preventDefault();
                        deleteSelectedFile(selectedNode.id);
                    }
                }
            });

            // Tarayıcı kapanma güvenliği
            window.addEventListener('beforeunload', function(e) {
                var anyDirty = Object.values(openFiles).some(f => f.isDirty);
                if (anyDirty) {
                    e.preventDefault();
                    e.returnValue = '';
                    return '';
                }
            });
        });

        // Tab geçiş yardımcı fonksiyonları
        function switchToNextTab() {
            var tabs = Object.keys(openFiles);
            if (tabs.length < 2) return;

            var currentIndex = tabs.indexOf(activeFilePath);
            if (currentIndex === -1) {
                // Aktif dosya yoksa ilk tab'a geç
                switchToTab(tabs[0]);
                return;
            }

            var nextIndex = (currentIndex + 1) % tabs.length;
            switchToTab(tabs[nextIndex]);
        }

        function switchToPreviousTab() {
            var tabs = Object.keys(openFiles);
            if (tabs.length < 2) return;

            var currentIndex = tabs.indexOf(activeFilePath);
            if (currentIndex === -1) {
                switchToTab(tabs[0]);
                return;
            }

            var prevIndex = (currentIndex - 1 + tabs.length) % tabs.length;
            switchToTab(tabs[prevIndex]);
        }

        function openNewFileDialog(folderPath) {
            selectedFolderPath = folderPath;
            $('#new-file-name').val('');
            updateTemplateOptions();
            $('#modal-new-file').modal('show');
        }

        function updateTemplateOptions() {
            var type = $('#new-file-type').val();
            $('#template-selector').toggle(type === 'cs');
        }

        function createNewFile() {
            var fileType = $('#new-file-type').val();
            var templateType = $('#new-file-template').val() || 'class';
            var fileName = $('#new-file-name').val().trim();

            if (!fileName) {
                showAlert("Error", "Please enter a file name.", "danger");
                return;
            }

            $.ajax({
                url: '/Editor/AddNewFile',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    ParentFolderPath: selectedFolderPath,
                    FileName: fileName,
                    FileType: fileType,
                    TemplateType: templateType
                }),
                success: function(response) {
                    $('#modal-new-file').modal('hide');
                    // ✅ hasServerChanges = true yapma, Git tabı GetModifiedFiles ile güncellenecek
                    updateUIStates(activeFilePath, openFiles[activeFilePath]?.isDirty || false);

                    openFileInTab(response.filePath, response.fileName);
                    $('#editor-treeview').jstree(true).refresh();
                    showCustomToast('success', `File '${response.fileName}' created and staged.`);
                },
                error: function(err) {
                    showAlert("Error", err.responseText || "Failed to create file.", "danger");
                }
            });
        }

        // Delete file function (context menu için)
        function deleteSelectedFile(filePath) {
            showConfirm("Delete File", "Are you sure you want to delete this file?", function() {
                $.ajax({
                    url: '/Editor/DeleteFile',
                    type: 'POST',
                    data: { filePath: filePath },
                    success: function(response) {
                        if (openFiles[filePath]) {
                            executeTabClosure(filePath, btoa(filePath).replace(/=/g, ""));
                        }
                        $('#editor-treeview').jstree(true).refresh();
                        // ✅ hasServerChanges = true yapma
                        updateUIStates(activeFilePath, openFiles[activeFilePath]?.isDirty || false);
                        // Git tabını yenile
                        if ($('#tab-git').hasClass('active')) {
                            refreshGitChanges();
                        }
                        showCustomToast('success', 'File deleted.');
                    },
                    error: function(err) {
                        showAlert("Error", err.responseText || "Could not delete file.", "danger");
                    }
                });
            });
        }

        // Rename function (context menu için)
        function renameSelectedFile(oldPath) {
            var oldName = oldPath.split('/').pop().split('\\').pop();
            var fileNameWithoutExt = oldName.substring(0, oldName.lastIndexOf('.'));
            var newName = prompt("Enter new name (without extension):", fileNameWithoutExt);
            if (newName && newName !== fileNameWithoutExt) {
                $.ajax({
                    url: '/Editor/RenameFile',
                    type: 'POST',
                    data: { oldPath: oldPath, newName: newName },
                    success: function(response) {
                        // Eski dosyayı tablardan kaldır, yeni dosyayı ekle
                        if (openFiles[oldPath]) {
                            var oldFile = openFiles[oldPath];
                            openFiles[response.newPath] = oldFile;
                            delete openFiles[oldPath];
                            // Tab UI güncellemesi için basit çözüm: tab'ı kapatıp yeni yolu aç
                            executeTabClosure(oldPath, btoa(oldPath).replace(/=/g, ""));
                            // Ağacı yenile
                            $('#editor-treeview').jstree(true).refresh();
                        }
                        hasServerChanges = true;
                        updateUIStates(activeFilePath, openFiles[activeFilePath]?.isDirty || false);
                        showCustomToast('success', 'File renamed.');
                    },
                    error: function(err) {
                        showAlert("Error", err.responseText || "Could not rename file.", "danger");
                    }
                });
            }
        }

        // --- Editor Management ---

        function createNormalEditor() {
            const container = document.getElementById('monaco-container');
            if (editor) {
                editor.dispose();
                editor = null;
            }
            if (diffEditor) {
                diffEditor.dispose();
                diffEditor = null;
            }
            container.innerHTML = '';

            editor = monaco.editor.create(container, {
                theme: 'vs-light',
                automaticLayout: true,
                fontSize: 14,
                minimap: { enabled: false },
                readOnly: true
            });
            isDiffMode = false;
            setupStepDefinitionLinker();
        }

        function openFileInTab(path, fileName) {
            if (isDiffMode) {
                createNormalEditor();
            }

            if (openFiles[path]) {
                switchToTab(path);
                return;
            }

            $.get('/Editor/GetFileContent', { filePath: path }, function (response) {
                var lang = getLanguageByExtension(fileName);
                var model = monaco.editor.createModel(response.content, lang);

                var backup = localStorage.getItem("backup_" + path);
                if(backup && backup !== response.content) {
                    showConfirm(
                        "Backup Found",
                        "Unsaved local changes were found for " + fileName + ". Should I load it?",
                        function() {
                            model.setValue(backup);
                        }
                    );
                }

                model.onDidChangeContent(() => {
                    openFiles[path].isDirty = true;
                    updateUIStates(path, true);
                    localStorage.setItem("backup_" + path, model.getValue());
                });

                openFiles[path] = { model: model, hash: response.hash, fileName: fileName, isDirty: false };
                addTabUI(path, fileName);
                switchToTab(path);
            });
        }

        function switchToTab(path) {
            if (isDiffMode) createNormalEditor();

            activeFilePath = path;
            var file = openFiles[path];
            editor.setModel(file.model);
            editor.updateOptions({ readOnly: false });

            $('.tab-item').removeClass('active');
            var safeId = btoa(path).replace(/=/g, "");
            $(`#tab-${safeId}`).addClass('active');

            updateUIStates(path, file.isDirty);

            // ✅ Model değiştiğinde linker'ı yeniden bağla
            setupStepDefinitionLinker();
        }

        function openDiffView(path, fileName) {
            $.get('/Editor/GetFileDiff', { filePath: path }, function (response) {
                isDiffMode = true;
                const container = document.getElementById('monaco-container');
                container.innerHTML = '';

                diffEditor = monaco.editor.createDiffEditor(container, {
                    theme: 'vs-light',
                    automaticLayout: true,
                    readOnly: true,
                    fontSize: 14
                });

                // ✅ Dil desteği: dosya uzantısına göre dil belirle
                var lang = getLanguageByExtension(fileName);

                const originalModel = monaco.editor.createModel(response.originalContent, lang);
                const modifiedModel = monaco.editor.createModel(response.modifiedContent, lang);

                diffEditor.setModel({
                    original: originalModel,
                    modified: modifiedModel
                });

                $('.tab-item').removeClass('active');
                activeFilePath = "";
            });
        }

        // --- Git & Tree Management ---

        function initializeTree() {
            $('#editor-treeview').jstree({
                'core': {
                    'check_callback': true,
                    'themes': { 'name': 'default', 'dots': false, 'icons': true },
                    'data': {
                        'url': '/Editor/GetProjectTree?projectId=' + projectId,
                        'dataType': 'json',
                        'dataFilter': function(data) {
                            var json = JSON.parse(data);
                            return JSON.stringify(json.filter(node =>
                                !node.text.includes('bin') &&
                                !node.text.includes('obj') &&
                                !node.text.includes('.vs')
                            ));
                        }
                    }
                },
                'types': {
                    'default': { 'icon': 'ti ti-file' },
                    'folder': { 'icon': 'ti ti-folder' }
                },
                'plugins': ['wholerow', 'types', 'contextmenu', 'rename'],
                'contextmenu': {
                    'items': function(node) {
                        var items = {};

                        if (node.original.type === 'folder') {
                            items['NewFile'] = {
                                'label': 'Add New Item...',
                                'icon': 'ti ti-file-plus',
                                'action': function() { openNewFileDialog(node.id); }
                            };
                        } else if (node.original.type === 'file') {
                            items['Rename'] = {
                                'label': 'Rename',
                                'icon': 'ti ti-pencil',
                                'action': function() {
                                    // Inline rename başlat
                                    $('#editor-treeview').jstree(true).edit(node);
                                }
                            };
                            items['Delete'] = {
                                'label': 'Delete',
                                'icon': 'ti ti-trash',
                                'action': function() { deleteSelectedFile(node.id); }
                            };
                        }

                        // Her zaman Refresh
                        items['Refresh'] = {
                            'label': 'Refresh',
                            'icon': 'ti ti-refresh',
                            'action': function() { $('#editor-treeview').jstree(true).refresh(); }
                        };

                        return items;
                    }
                }
            })
            .on('select_node.jstree', function (e, data) {
                if (data.node.original.type !== "folder") {
                    openFileInTab(data.node.id, data.node.text);
                }
            })
            .on('open_node.jstree', function (e, data) {
                var anchor = document.getElementById(data.node.id + "_anchor");
                if(anchor) {
                    $(anchor).prev('.jstree-ocl').removeClass('ti-arrow-badge-right').addClass('ti-arrow-badge-down');
                    $(anchor).find('i.jstree-themeicon').removeClass('ti-folder').addClass('ti-folder-open');
                }
            })
            .on('close_node.jstree', function (e, data) {
                var anchor = document.getElementById(data.node.id + "_anchor");
                if(anchor) {
                    $(anchor).prev('.jstree-ocl').removeClass('ti-arrow-badge-down').addClass('ti-arrow-badge-right');
                    $(anchor).find('i.jstree-themeicon').removeClass('ti-folder-open').addClass('ti-folder');
                }
            })
            .on('ready.jstree', function () {
                $('.jstree-closed > .jstree-ocl').addClass('ti ti-arrow-badge-right');
                $('.jstree-opened > .jstree-ocl').addClass('ti ti-arrow-badge-down');
            })
            .on('rename.jstree', function (e, data) {
                // Düzenleme başlarken uzantıyı gizle (sadece dosya adı görünsün)
                var oldName = data.node.text;
                var lastDot = oldName.lastIndexOf('.');
                if (lastDot > 0) {
                    // Orijinal tam ismi (uzantılı) bir data attribute olarak sakla
                    data.node.original.fullName = oldName;
                    data.node.text = oldName.substring(0, lastDot);
                } else {
                    // Nokta yoksa (örneğin uzantısız dosya) orijinal ismi olduğu gibi bırak
                    data.node.original.fullName = oldName;
                }
            })
            .on('rename_node.jstree', function (e, data) {
                var oldFullName = data.old;                    // orijinal text (uzantılı)
                var newNameInput = data.text;                 // kullanıcının girdiği yeni isim

                // Uzantıyı ayıkla
                var extension = '';
                var lastDotInOld = oldFullName.lastIndexOf('.');
                if (lastDotInOld > 0) {
                    extension = oldFullName.substring(lastDotInOld);  // .feature gibi
                }

                // Yeni tam ismi oluştur
                var newFullName;
                if (newNameInput.includes('.')) {
                    // Kullanıcı kendi uzantısını vermiş
                    newFullName = newNameInput;
                } else if (extension) {
                    // Uzantı verilmemiş, eski uzantıyı ekle
                    newFullName = newNameInput + extension;
                } else {
                    // Uzantısız dosya (nadir durum)
                    newFullName = newNameInput;
                }

                // Sunucuya HER ZAMAN uzantısız ismi gönder
                var newNameWithoutExt = newNameInput.includes('.')
                    ? newNameInput.substring(0, newNameInput.lastIndexOf('.'))
                    : newNameInput;

                var oldPath = data.node.id;  // eski tam path (sunucu tarafında kullanılacak)

                $.ajax({
                    url: '/Editor/RenameFile',
                    type: 'POST',
                    data: { oldPath: oldPath, newName: newNameWithoutExt },  // sunucuya uzantısız gönder
                    success: function(response) {
                        // Yeni path'i al
                        var newPath = response.newPath;

                        // openFiles'taki eski path'i yeni path ile güncelle
                        if (openFiles[oldPath]) {
                            var fileData = openFiles[oldPath];
                            fileData.fileName = newFullName;
                            openFiles[newPath] = fileData;
                            delete openFiles[oldPath];

                            // Tab UI'ı güncelle
                            var oldSafeId = btoa(oldPath).replace(/=/g, "");
                            var newSafeId = btoa(newPath).replace(/=/g, "");
                            var $tab = $(`#tab-${oldSafeId}`);
                            if ($tab.length > 0) {
                                $tab.attr('id', `tab-${newSafeId}`);
                                $tab.find('.tab-title').text(newFullName);
                                $tab.attr('onclick', `switchToTab(decodeURIComponent('${encodeURIComponent(newPath)}'))`);
                                $tab.find('.tab-close').attr('onclick', `closeTab(event, decodeURIComponent('${encodeURIComponent(newPath)}'))`);
                            }

                            // Aktif dosya buysa activeFilePath'i güncelle
                            if (activeFilePath === oldPath) {
                                activeFilePath = newPath;
                            }
                        }

                        // ✅ Node'un id'sini jsTree API'si ile güncelle (hata vermez)
                        $('#editor-treeview').jstree(true).set_id(data.node, newPath);

                        // Node text'ini güncelle
                        $('#editor-treeview').jstree(true).set_text(data.node, newFullName);

                        // UI durumunu güncelle
                        updateUIStates(activeFilePath, openFiles[activeFilePath]?.isDirty || false);
                        showCustomToast('success', 'File renamed.');
                    },
                    error: function(err) {
                        showAlert("Error", err.responseText || "Could not rename file.", "danger");
                        $.jstree.rollback(data);
                    }
                });
            });
        }

        function refreshGitChanges() {
            $.get('/Editor/GetModifiedFiles', { projectId: projectId }, function (data) {
                var filteredData = data.filter(item =>
                    !item.id.includes('\\bin\\') &&
                    !item.id.includes('\\obj\\') &&
                    !item.id.includes('.vs\\')
                );

                var tree = $('#git-changes-treeview').jstree(true);
                if (tree) {
                    tree.settings.core.data = filteredData;
                    tree.refresh();
                } else {
                    $('#git-changes-treeview').jstree({
                        'core': { 'data': filteredData },
                        'plugins': ['types']
                    }).on('select_node.jstree', function (e, data) {
                        openDiffView(data.node.id, data.node.text);
                    });
                }
            });
        }

        function switchSidebar(type) {
            $('.explorer-tab-item').removeClass('active');
            $(`#tab-${type}`).addClass('active');

            if (type === 'solution') {
                $('#panel-solution').removeClass('d-none');
                $('#panel-git').addClass('d-none');
            } else {
                $('#panel-solution').addClass('d-none');
                $('#panel-git').removeClass('d-none');
                refreshGitChanges();
            }
            setTimeout(() => { if(editor) editor.layout(); }, 50);
        }

        // --- UI & Helper Methods ---

        function addTabUI(path, fileName) {
            $('#no-file-msg').hide();
            var safePath = encodeURIComponent(path);
            var safeId = btoa(path).replace(/=/g, "");
            var tabHtml = `
                <div class="tab-item" id="tab-${safeId}" onclick="switchToTab(decodeURIComponent('${safePath}'))">
                    <span class="tab-title">${fileName}</span>
                    <i class="ti ti-x tab-close" onclick="closeTab(event, decodeURIComponent('${safePath}'))"></i>
                </div>`;
            $('#editor-tabs').append(tabHtml);
        }

        function closeTab(event, path) {
            event.stopPropagation();
            const safeId = btoa(path).replace(/=/g, "");

            if (openFiles[path].isDirty) {
                showConfirm("Unsaved Changes", "There are unsaved changes in this file. Are you sure you want to close it?", function() {
                    executeTabClosure(path, safeId);
                });
            } else {
                executeTabClosure(path, safeId);
            }
        }

        function executeTabClosure(path, safeId) {
            // Model'i dispose et
            if (openFiles[path] && openFiles[path].model) {
                openFiles[path].model.dispose();
            }
    
            // Tab'ı DOM'dan kaldır
            $(`#tab-${safeId}`).remove();
            delete openFiles[path];

            // Başka açık dosya var mı kontrol et
            var remainingPaths = Object.keys(openFiles);
            if (remainingPaths.length > 0) {
                // Son kalan tab'a geç
                var lastPath = remainingPaths[remainingPaths.length - 1];
                switchToTab(lastPath);
            } else {
                // Hiç tab kalmadıysa editor'ü temizle
                activeFilePath = "";
                if (editor) {
                    editor.setModel(null);
                }
                $('#no-file-msg').show();
                updateUIStates(null, false);
            }
        }

        function updateUIStates(path, isDirty) {
            if (activeFilePath === path) {
                $('#btn-save').prop('disabled', !isDirty).toggleClass('btn-toolbar-active', isDirty);
            }

            var anyFileDirty = Object.values(openFiles).some(f => f.isDirty);
            $('#btn-save-all').prop('disabled', !anyFileDirty).toggleClass('btn-toolbar-active', anyFileDirty);

            var currentBranch = $('#branch-dropdown').val();
            var isForbiddenBranch = (currentBranch === "main" || currentBranch === "master");

            // hasServerChanges: sadece save işlemlerinde true olur, rename/delete/newFile ayrıca kontrol edilir
            var canPush = (anyFileDirty || hasServerChanges) && !isForbiddenBranch;

            $('#btn-git-push')
                .prop('disabled', !canPush)
                .toggleClass('btn-success', !isForbiddenBranch)
                .toggleClass('btn-secondary', isForbiddenBranch);
            $('#btn-send-server').prop('disabled', !canPush).toggleClass('ti-cloud-upload btn-toolbar-success', hasServerChanges);

            window.onbeforeunload = anyFileDirty ? function() { return "You have unsaved changes!"; } : null;

            if (path) {
                var safePath = path.replace(/\\/g, "\\\\");
                var nodeAnchor = $(`#${safeId(path)}_anchor`); 

                if (isDirty) {
                    nodeAnchor.addClass('file-dirty');
                } else {
                    nodeAnchor.removeClass('file-dirty');
                }
            }
        }

        function getLanguageByExtension(fileName) {
            var ext = fileName.split('.').pop().toLowerCase();
            var map = {
                'cs': 'csharp',
                'java': 'java',
                'feature': 'gherkin',
                'json': 'json',
                'csproj': 'xml',
                'xml': 'xml',
                'js': 'javascript',
                'ts': 'typescript',
                'html': 'html',
                'css': 'css',
                'py': 'python',
                'rb': 'ruby',
                'md': 'markdown'
            };
            return map[ext] || 'plaintext';
        }

        function saveCurrentFile() {
            if (!activeFilePath || !openFiles[activeFilePath].isDirty) return;

            var file = openFiles[activeFilePath];

            $.ajax({
                url: '/Editor/SaveFileContent',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    FilePath: activeFilePath,
                    Content: file.model.getValue(),
                    ClientHash: file.hash
                }),
                success: function(response) {
                    file.hash = response.newHash;
                    file.isDirty = false;
                    hasServerChanges = true;

                    updateUIStates(activeFilePath, false);
                    localStorage.removeItem("backup_" + activeFilePath);

                    showCustomToast('success', "File saved successfully: " + file.fileName);
                },
                error: function(err) {

                }
            });
        }

        function saveAllFiles() {
            const dirtyPaths = Object.keys(openFiles).filter(path => openFiles[path].isDirty);

            if (dirtyPaths.length === 0) return;

            const savePromises = dirtyPaths.map(path => {
                var file = openFiles[path];
                return $.ajax({
                    url: '/Editor/SaveFileContent',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({
                        FilePath: path,
                        Content: file.model.getValue(),
                        ClientHash: file.hash
                    }),
                    success: function(response) {
                        file.hash = response.newHash;
                        file.isDirty = false;
                        hasServerChanges = true;
                        updateUIStates(path, false);
                        localStorage.removeItem("backup_" + path);
                    }
                });
            });

            $.when.apply($, savePromises).then(function() {
                showCustomToast('success', "All files saved successfully.");
            });
        }

        function safeId(path) {
            return path.replace(/(:|\.|\/|\\|\[|\]|,|=|\x40)/g, "\\$1");
        }

        function refreshTree() {
            $('#editor-treeview').jstree(true).refresh();
            showCustomToast('success', "Solution Explorer refreshed.");
        }

        function refreshBranchList(selectedBranch = null) {
            $.get('/Editor/GetProjectBranches', { projectId: projectId }, function (data) {
                let html = '<optgroup label="Local Branches">';
                data.branches.forEach(b => {
                    let selected = (selectedBranch || data.current) === b ? 'selected' : '';
                    html += `<option value="${b}" ${selected}>${b}</option>`;
                });
                html += '</optgroup><optgroup label="Actions"><option value="CREATE_NEW">+ New Branch...</option></optgroup>';

                $('#branch-dropdown').html(html);
            });
        }

        function handleBranchChange(value) {
            if (value === "CREATE_NEW") {
                if (typeof window.openBranchModal === "function") {
                    window.openBranchModal();
                }
                return;
            }
            // value is an existing branch name
            if (value) {
                switchToBranch(value);
            }
        }

        window.handlePushAction = function() {
            var selectedBranch = $('#branch-dropdown').val();

            if (selectedBranch === "main" || selectedBranch === "master") {
                showCustomToast('warning', "You can not push changes to the main branch! Before push change, create a branch, please!");
                return;
            }

            if (selectedBranch === "CREATE_NEW") {
                window.openBranchModal();
            } else {
                executePush(selectedBranch);
            }
        };

        function executePush(branchName) {
            const btn = $('#btn-git-push');
            btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm"></span> Pushing...');

            $.ajax({
                url: '/Editor/CommitAndPush',
                type: 'POST',
                data: { projectId: projectId, branchName: branchName },
                success: function(response) {
                    showCustomToast('success', "Pushed to " + branchName);
                    setTimeout(() => {
                        refreshBranchList(response.currentBranch);
                        refreshPushHistory();
                        refreshGitChanges();
                    }, 500);
                },
                error: function(err) {  
                    showAlert("Push Failed", err.responseText, "danger"); 
                },
                complete: function() { 
                    btn.prop('disabled', false).html('<i class="ti ti-upload me-1"></i> Push');
                }
            });
        }

        function finalizePRCreation() {
            const prData = {
                ProjectId: currentPRContext.projectId,
                SourceBranch: currentPRContext.source,
                TargetBranch: $('#pr-target-branch').val(),
                LastCommitHash: currentPRContext.hash,
                Reviewers: $('#pr-reviewers').val() || [],
                Description: $('#pr-comment').val() 
            };

            $.ajax({
                url: '/Editor/CreatePRWithDetails',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(prData),
                success: function(response) {
                    showCustomToast('success', "Pull Request created successfully!");
                    $('#modal-create-pr-detail').modal('hide');
                    refreshPushHistory();
                },
                error: function(err) {
                    console.error("PR Error Details:", err.responseText);
                    showCustomToast('danger', "Error: " + err.responseText);
                }
            });
        }

        function refreshPushHistory() {
            $.get('/Editor/GetPushHistory', { projectId: projectId }, function (data) {
                let fullHtml = '';
                let sideHtml = '';

                data.forEach(item => {
                    let actionBtn = "";

                    if (!item.hasPR) {
                        actionBtn = `<button class="btn btn-sm btn-outline-primary" onclick="openPRCreateDetail('${item.projectId}', '${item.branchName}', '${item.commitHash}')">PR</button>`;
                    } else {
                        actionBtn = `<a href="/Editor/PRDetails/${item.prId}" class="modal-link btn btn-sm btn-info">Check</a>`;
                    }

                    fullHtml += `
                        <tr>
                            <td><span class="badge bg-blue-lt">${item.branchName}</span></td>
                            <td>${item.pushedBy}</td>
                            <td>${item.pushedAt}</td>
                            <td>${actionBtn}</td>
                        </tr>`;

                    sideHtml += `
                        <div class="p-2 border-bottom small">
                            <div class="d-flex justify-content-between">
                                <span class="badge bg-blue-lt">${item.branchName}</span>
                                <span class="text-muted" style="font-size:10px;">${item.pushedAt}</span>
                            </div>
                            <div class="mt-1 d-flex justify-content-between align-items-center">
                                <span class="text-truncate" style="max-width: 100px;">${item.pushedBy}</span>
                                ${actionBtn}
                            </div>
                        </div>`;
                });

                $('#full-history-table-body').html(fullHtml);
                $('#push-history-list').html(sideHtml);
            });
        }

        window.openBranchModal = function() {
            var myModal = new bootstrap.Modal(document.getElementById('modal-branch'));
            myModal.show();
        };

        window.pullLatest = function() {
            const btn = event.currentTarget;
            const originalContent = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Pulling...';

            $.ajax({
                url: '/Editor/PullLatest',
                type: 'POST',
                data: { projectId: projectId },
                success: function(response) {
                    showCustomToast('success', response.message);
                    refreshTree();
                    if ($('#tab-git').hasClass('active')) refreshGitChanges();
                },
                error: function(err) {
                    showCustomToast('danger', "Pull failed: " + err.responseText);
                },
                complete: function() {
                    btn.disabled = false;
                    btn.innerHTML = originalContent;
                }
            });
        };

        window.commitAndPush = function() {
            var newBranchName = $('#input-branch-name').val();
    
            // MODAL GÜNCELLEMESİ: showAlert
            if (!newBranchName) { 
                showAlert("Missed Information", "Please enter a branch name!", "warning"); 
                return; 
            }

            executePush(newBranchName);
            $('#modal-branch').modal('hide');
            $('#input-branch-name').val('');
        };

        function openHistoryModal() {
            $.get('/Editor/GetPushHistory', { projectId: projectId }, function (data) {
                let html = '';
                data.forEach(item => {
                    const originBranch = item.originBranch || "main";

                    let actionContent = !item.hasPR
                        ? `<button class="btn btn-sm btn-primary" onclick="openPRCreateDetail('${item.projectId}', '${item.branchName}', '${item.commitHash}')">Create PR</button>`
                        : `<a href="/Editor/PRDetails/${item.prId}" class="btn btn-sm btn-info">View PR</a>`;

                    html += `
                        <tr>
                            <td><span class="badge bg-blue-lt">${item.branchName}</span></td>
                            <td class="text-muted">${originBranch}</td>
                            <td>${item.pushedBy}</td>
                            <td>${item.pushedAt}</td>
                            <td><code class="text-reset">${item.commitHash.substring(0, 7)}</code></td>
                            <td>${actionContent}</td>
                        </tr>`;
                });
                $('#full-history-table-body').html(html);
                new bootstrap.Modal(document.getElementById('modal-history-large')).show();
            });
        }

        function openPRCreateDetail(pId, source, hash) {
            currentPRContext = { projectId: pId, source: source, hash: hash };

            $('#pr-source-branch').val(source);
            $('#pr-target-branch').val('');
            $('#pr-comment').val('');
            $('#btn-submit-pr').prop('disabled', true);

            $.get('/Editor/GetProjectBranches', { projectId: pId }, function (data) {
                let branchHtml = '<option value="">Select Target...</option>';
                data.branches.forEach(b => {
                    if (b !== source) {
                        branchHtml += `<option value="${b}">${b}</option>`;
                    }
                });
                $('#pr-target-branch').html(branchHtml);
            });

            let targetBranch = $('#pr-target-branch').val() || "main";
            $.get('/Editor/GetFilesBetweenBranches', {
                projectId: pId,
                source: source,
                target: targetBranch
            }, function (files) {
                let fileHtml = '<ul class="list-unstyled mb-0">';
                if (!files || files.length === 0) fileHtml += '<li>No changes relative to target branch.</li>';
                else {
                    files.forEach(f => {
                        fileHtml += `<li><i class="ti ti-file-diff text-warning me-1"></i> ${f}</li>`;
                    });
                }
                fileHtml += '</ul>';
                $('#pr-file-diff-list').html(fileHtml);
            });

            $.get('/Editor/GetReviewers', function (users) {
                let userHtml = '';
                users.forEach(u => {
                    userHtml += `<option value="${u.val}">${u.text}</option>`;
                });
                $('#pr-reviewers').html(userHtml);

                window.hasOtherReviewers = users.length > 0;
                validatePRForm();
            });

            $('#modal-create-pr-detail').modal('show');
        }

        // Form doğrulama (Target Branch ve Comment zorunlu)
        function validatePRForm() {
            const target = $('#pr-target-branch').val();
            const comment = $('#pr-comment').val().trim();
            const selectedReviewers = $('#pr-reviewers').val() || [];

            const isReviewerValid = window.hasOtherReviewers ? selectedReviewers.length > 0 : true;

            $('#btn-submit-pr').prop('disabled', !(target && comment && isReviewerValid));
        }

        function switchToBranch(branchName) {
            // Check for unsaved open files
            var anyDirty = Object.values(openFiles).some(f => f.isDirty);
            if (anyDirty) {
                showConfirm("Unsaved Changes",
                    "You have unsaved files. Switching branches will discard all changes. Continue?",
                    function() {
                        performBranchSwitch(branchName);
                    });
            } else {
                performBranchSwitch(branchName);
            }
        }

        function performBranchSwitch(branchName) {
            $.ajax({
                url: '/Editor/SwitchBranch',
                type: 'POST',
                data: { projectId: projectId, branchName: branchName },
                success: function(response) {
                    // Close all open tabs and clear editor
                    closeAllTabs();
                    // Refresh the solution tree
                    $('#editor-treeview').jstree(true).refresh();
                    // Update the dropdown to reflect the new branch
                    refreshBranchList(branchName);
                    // Also refresh git changes if the Git tab is active
                    if ($('#tab-git').hasClass('active')) {
                        refreshGitChanges();
                    }
                    showCustomToast('success', `Switched to branch '${branchName}'.`);
                },
                error: function(err) {
                    showAlert("Branch Switch Failed", err.responseText || "Could not switch branch.", "danger");
                }
            });
        }

        function closeAllTabs() {
            // Dispose editor models (optional, to free memory)
            for (let path in openFiles) {
                if (openFiles[path].model) {
                    openFiles[path].model.dispose();
                }
            }
            openFiles = {};
            activeFilePath = "";
            $('#editor-tabs').empty().html('<span id="no-file-msg" class="text-muted small italic px-2">No file open</span>');
            if (editor) {
                editor.setModel(null);
            }
            // Remove dirty markers from tree items
            $('.file-dirty').removeClass('file-dirty');
            updateUIStates(null, false);
        }

        // Step Definition Linker
        var stepLinkerDisposable = null;

        function setupStepDefinitionLinker() {
            if (!editor) return;

            if (stepLinkerDisposable) {
                stepLinkerDisposable.dispose();
                stepLinkerDisposable = null;
            }

            stepLinkerDisposable = editor.onMouseDown(function(e) {
                if (!(e.event.ctrlKey || e.event.metaKey)) return;
                if (!e.target.position) return;

                if (!activeFilePath) return;
                var fileName = activeFilePath.replace(/\\/g, '/').split('/').pop() || '';

                if (!fileName.toLowerCase().endsWith('.feature')) return;

                var model = editor.getModel();
                if (!model) return;

                var lineNumber = e.target.position.lineNumber;
                var lineContent = model.getLineContent(lineNumber).trim();

                e.event.preventDefault();

                var stepMatch = lineContent.match(/^\s*(Given|When|Then|And|But)\s+(.+)$/i);
                if (!stepMatch) {
                    showCustomToast('info', 'Click on a Given/When/Then/And/But step to navigate.');
                    return;
                }

                var stepText = stepMatch[2].trim();

                $.ajax({
                    url: '/Editor/FindStepDefinition',
                    type: 'GET',
                    data: {
                        projectId: projectId,
                        stepText: stepText
                    },
                    success: function(response) {
                        if (response.success) {
                            var targetFileName = response.filePath.replace(/\\/g, '/').split('/').pop();

                            openFileInTab(response.filePath, targetFileName);

                            setTimeout(function() {
                                if (editor) {
                                    editor.revealLineInCenter(response.lineNumber);
                                    editor.setPosition({
                                        lineNumber: response.lineNumber,
                                        column: 1
                                    });

                                    var decorations = editor.deltaDecorations([], [{
                                        range: new monaco.Range(response.lineNumber, 1, response.lineNumber, 1),
                                        options: {
                                            isWholeLine: true,
                                            className: 'step-definition-highlight'
                                        }
                                    }]);

                                    setTimeout(function() {
                                        editor.deltaDecorations(decorations, []);
                                    }, 3000);
                                }
                            }, 500);

                            showCustomToast('success', `Found: ${targetFileName} line ${response.lineNumber}`);
                        } else {
                            showCustomToast('warning', 'No step definition found for this step.');
                        }
                    },
                    error: function(err) {
                        showAlert("Error", "Failed to search step definitions.", "danger");
                    }
                });
            });
        }

        function showConfirm(title, message, onConfirm) {
            $('#confirm-title').text(title);
            $('#confirm-text').text(message);
            $('#confirm-yes-btn').off('click').one('click', function() {
                onConfirm();
            });
            new bootstrap.Modal(document.getElementById('modal-confirm')).show();
        }

        function showAlert(title, message, type = 'info') {
            $('#alert-title').text(title);
            $('#alert-text').text(message);
            const iconMap = { 'success': 'ti-check', 'danger': 'ti-x', 'warning': 'ti-alert-triangle', 'info': 'ti-info-circle' };
            $('#alert-icon').attr('class', `ti ${iconMap[type] || 'ti-info-circle'} fs-1 text-${type} mb-2`);
            new bootstrap.Modal(document.getElementById('modal-alert')).show();
        }
    </script>
}